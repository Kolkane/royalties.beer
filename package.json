{
  "name": "royalties",
  "version": "0.2.3",
  "description": "Open-source collector that pays developers royalties on their AI coding session metadata — never their code.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "royalties": "dist/cli.js"
  },
  "files": [
    "dist",
    "SCHEMA.md",
    "PRIVACY.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kolkane/royalties.beer.git"
  },
  "homepage": "https://github.com/Kolkane/royalties.beer",
  "bugs": "https://github.com/Kolkane/royalties.beer/issues",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
